{
  "name": "depths-of-moria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Fellowship: Depths of Moria — a long-form fantasy auto-battler (private fan-game concept).",
  "scripts": {
    "dev": "vite",
